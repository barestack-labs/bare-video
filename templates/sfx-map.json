{
  "version": "0.1.0",
  "rules": {
    "speech_priority": true,
    "max_simultaneous_accents": 1,
    "default_density": "active-but-restrained"
  },
  "events": {
    "pop-soft": {
      "use_for": [
        "small popup",
        "badge",
        "floating card"
      ]
    },
    "whoosh-soft": {
      "use_for": [
        "split layout transition",
        "slide-in"
      ]
    },
    "impact-light": {
      "use_for": [
        "screenshot landing",
        "proof reveal"
      ]
    },
    "impact-medium": {
      "use_for": [
        "big stat",
        "payoff",
        "takeover"
      ]
    },
    "click-soft": {
      "use_for": [
        "UI",
        "terminal",
        "button"
      ]
    },
    "chime-soft": {
      "use_for": [
        "success",
        "checkmark"
      ]
    },
    "none": {
      "use_for": [
        "plain cut",
        "emotional beat",
        "rapid sequence when another accent would clutter"
      ]
    }
  }
}